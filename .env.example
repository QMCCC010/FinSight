APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=change-me-internal
DATABASE_URL=mysql+pymysql://finresearch:finresearch@mysql:3306/finresearch?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ORIGINS=http://localhost:5173
STORAGE_ROOT=/app/data
COLLECTOR_URL=http://collector:5000
COLLECTION_MODE=AUTO

# OpenAI-compatible chat endpoint. Leave blank to use the deterministic demo fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
# DeepSeek V4 defaults to high-effort thinking unless explicitly configured.
# Keep low-effort thinking for final research answers and disable it for routing.
LLM_THINKING_MODE=enabled
LLM_REASONING_EFFORT=low
ROUTER_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LLM_STREAM_FIRST_CONTENT_TIMEOUT_SECONDS=180
LLM_STREAM_IDLE_TIMEOUT_SECONDS=60
LLM_STREAM_OVERALL_TIMEOUT_SECONDS=480
# Optional OpenAI-compatible fallback provider.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
ENABLE_LOCAL_EMBEDDINGS=true
# Shared by API and workers through Docker's persistent model_cache volume.
EMBEDDING_CACHE_DIR=/root/.cache/huggingface/fastembed
VECTOR_STORE_BACKEND=milvus
VECTOR_STORE_FALLBACK=true
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=financial_chunks_v1
MILVUS_MEMORY_COLLECTION_NAME=chat_memory_v1
MILVUS_TIMEOUT_SECONDS=30
CONVERSATION_HISTORY_TOKEN_BUDGET=4000
CONVERSATION_RECENT_TURNS=4
CONVERSATION_RECALL_LIMIT=2
CONVERSATION_SUMMARY_TRIGGER_TURNS=10
ROUTER_HISTORY_TOKEN_BUDGET=1200
ROUTER_RECENT_TURNS=3
ANSWER_HISTORY_TOKEN_BUDGET=2500
ANSWER_RECENT_TURNS=4

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ANALYST_USERNAME=analyst
SEED_ANALYST_PASSWORD=Analyst123!
JWT_EXPIRE_MINUTES=480
